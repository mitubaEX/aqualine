{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aqualine-mvp",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "observability": {"enabled":false,"head_sampling_rate":0,"redact_query_string":true,"logs":{"enabled":false,"invocation_logs":false,"persist":false},"traces":{"enabled":false,"persist":false}},
  "vars": {"ENVIRONMENT":"production"},
  "assets":{"directory":"./dist","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*"]},
  "durable_objects":{"bindings":[{"name":"PLAZA","class_name":"Plaza"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["Plaza"]}],
  "env":{"local":{"vars":{"ENVIRONMENT":"development"},"durable_objects":{"bindings":[{"name":"PLAZA","class_name":"Plaza"}]}}}
}
